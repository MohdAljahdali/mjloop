# Dependencies
node_modules/

# Build output. engine/dist/ is deliberately NOT ignored: a Claude Code plugin
# ships what is in git and runs it as-is, with no install step. Shipping only
# src/ shipped nothing that runs — the MCP server and all three hooks point
# into dist/. It is bundled (no node_modules needed) by `npm run build`.
*.tsbuildinfo

# Test output
coverage/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*

# OS
.DS_Store

# Loop execution state — this repo is the plugin, not a project it runs on
.mjloop/
CLAUDE.md

# Editors
.idea/
.vscode/
*.swp
