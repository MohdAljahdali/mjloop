# Dependencies
node_modules/

# Build output. engine/dist/ is deliberately NOT ignored: a Claude Code plugin
# ships what is in git and runs it as-is, with no install step. Shipping only
# src/ shipped nothing that runs — the MCP server and all three hooks point
# into dist/. It is bundled (no node_modules needed) by `npm run build`.
*.tsbuildinfo
.worktrees/

# Declaration output of `engine/tsconfig.protocol.json`, the composite build
# that lets `tsconfig.web.json` resolve `Snapshot`/`ClientMessage`/`Write`
# through project references instead of Node-touching source. Rebuilt by
# `npm run typecheck`; never shipped.
engine/.ts-out/

# Test output
coverage/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*

# OS
.DS_Store

# Loop execution state — this repo is the plugin, not a project it runs on
.mjloop/
CLAUDE.md

# Editors
.idea/
.vscode/
*.swp

# Skills installed into this checkout by a third-party manager, not project
# content: `skills-lock.json` pins a `SKILL.md` fetched from another repository.
# A plugin that ships to other people should not carry somebody else's skill
# along with it. Delete these three lines to track them.
.agents/
.claude/
skills-lock.json
