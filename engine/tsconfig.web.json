{
  /*
   * Type checking for the page, including its templates.
   *
   * Run through `vue-tsc` in the `typecheck` script rather than `tsc`: a typo
   * in `{{ snapshot.state.trakc }}` is a compile error here, where the old
   * JSDoc pass over hand-written DOM could only see the JavaScript.
   *
   * It emits nothing. Vite does the emitting.
   *
   * `tsc -b tsconfig.protocol.json` must run before `vue-tsc -p tsconfig.web.json`
   * — see the `references` entry below. A bare `vue-tsc -p tsconfig.web.json` on
   * a tree with no `.ts-out/` fails with `TS6305` on every type this program
   * gets through that reference, plus a cascade of unrelated-looking `TS7006`s
   * from the app files that import them. `npm run typecheck` and
   * `tests/web/typeguard.test.ts` already build it first; do the same for any
   * other direct invocation of this config.
   */
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "strict": true,
    "jsx": "preserve",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/web/app/**/*.ts", "src/web/app/**/*.vue", "src/web/app/env.d.ts", "tests/web/**/*.ts"],
  /*
   * `app/types/protocol.ts` re-exports types from `protocol.ts` and
   * `writes.ts`. Some of those (`ClientMessage`, `Write`) are `z.infer` of a
   * schema built from Node-touching server modules, so resolving them from
   * source pulls that whole graph in. This reference makes TypeScript resolve
   * them from `tsconfig.protocol.json`'s built `.d.ts` instead — see that
   * file for why a type-only barrel alone could not do this.
   */
  "references": [{ "path": "./tsconfig.protocol.json" }]
}
