{
  "name": "@mjloop/engine",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "mjloop-mcp": "./dist/mcp/server.js",
    "mjloop-cli": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "bash ../tests/e2e/run-edit.sh",
    "e2e:build": "bash ../tests/e2e/run-build.sh",
    "e2e:fix": "bash ../tests/e2e/run-fix.sh",
    "e2e:story": "bash ../tests/e2e/run-story.sh",
    "e2e:plan": "bash ../tests/e2e/run-plan.sh",
    "e2e:design": "bash ../tests/e2e/run-design-sync.sh",
    "e2e:add": "bash ../tests/e2e/run-add.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
